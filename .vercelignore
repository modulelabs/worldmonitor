# Exclude local desktop build artifacts and sidecar binaries from deployments
# These files are large and not needed by the Vercel-hosted frontend/API

# Tauri build outputs
src-tauri/target/
src-tauri/bundle/

# Sidecar and bundled node binaries
src-tauri/sidecar/
src-tauri/**/node

# macOS disk images and app bundles
**/*.dmg
**/*.app

# Rust/Cargo build artifacts (safety)
target/

# Common local artifacts
.DS_Store

# NPC React preview (:3020) is a static SPA. /api is edge-rewritten to
# api.worldmonitor.app — do not upload serverless handlers (Hobby limit +
# empty output when VC tries to package the full WM api/ tree).
api/
server/

# Never deploy api test files if api/ is re-enabled later.
api/**/*.test.mjs
