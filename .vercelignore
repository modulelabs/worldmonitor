# Top-level api entries: ignore all, then re-include the Hobby allowlist + helpers.
api/*.js
api/*.ts
api/*.mjs
!api/_*.js
!api/_*.ts
!api/_*.mjs
!api/bootstrap.js
!api/health.js
!api/version.js
!api/geo.js
!api/product-catalog.js
