{
  "buildCommand": "node scripts/npc-react-vercel-build.mjs",
  "outputDirectory": "react/dist",
  "installCommand": "npm install --ignore-scripts",
  "framework": null,
  "crons": [],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.worldmonitor.app/api/:path*"
    },
    {
      "source": "/wm-mcp",
      "destination": "https://worldmonitor.app/mcp"
    },
    {
      "source": "/wm-mcp/:path*",
      "destination": "https://worldmonitor.app/mcp/:path*"
    },
    {
      "source": "/((?!api/|wm-mcp).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
